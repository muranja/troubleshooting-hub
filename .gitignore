# Ignore all personal troubleshooting markdown entries & local folders by default
*.md
**/*.md
boot-and-startup/
network-and-ports/
systemd-and-services/
build-and-deploy/
app-debugging/
local/
personal/
private/
notes/

# Whitelist public tool docs, templates, generic examples, and skill package
!README.md
!templates/
!templates/TEMPLATE.md
!examples/
!examples/*.md
!skill/
!skill/**

# Python, editor, and runtime artifacts (always ignored, including inside skill/)
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.venv/
.pytest_cache/
.ruff_cache/
.DS_Store
files.json
*.log
*.state
